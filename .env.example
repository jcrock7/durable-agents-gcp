# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env

# ---------- GCP ----------
PROJECT_ID=your-project-id
REGION=us-central1
ZONE=us-central1-a
CLUSTER_NAME=agents-demo
AR_REPO=agents
TF_STATE_BUCKET=your-project-id-tfstate

# ---------- Cost guardrails (scripts/gcp/cost-guardrails.sh) ----------
# Billing account ID: gcloud billing accounts list
BILLING_ACCOUNT_ID=000000-000000-000000
# Whole units of the billing account currency. ~10 cluster hours/week is ~$5-15/month plus model tokens.
MONTHLY_BUDGET_USD=25
# Comma-separated, max 5. Billing account admins are emailed too.
BUDGET_ALERT_EMAILS=you@example.com
# dry_run logs decisions only; switch to enforce after `cost-guardrails.sh test` looks right.
BUDGET_ENFORCEMENT_MODE=dry_run
# Fractions of the monthly budget (actual spend). 0 turns an action off.
BUDGET_STOP_CLUSTERS_AT=1.0
BUDGET_DISABLE_BILLING_AT=1.2
# Delete any GKE cluster older than this many hours. 0 turns it off.
CLUSTER_MAX_HOURS=8

# ---------- Foundation layer (scripts/gcp/foundation.sh) ----------
# Who may open the app through IAP: comma-separated user:/group: members.
IAP_MEMBERS=user:you@example.com
# GitHub repo allowed to deploy from Actions (owner/name). Leave empty to skip CI federation.
GITHUB_REPOSITORY=your-github-user/durable-agents-gcp

# ---------- Cluster layer (scripts/gke/up.sh, down.sh) ----------
# CIDRs allowed to reach the Kubernetes API, comma-separated. Required: up.sh refuses to open
# the control plane to the whole internet. Your IP: curl -s ifconfig.me  (then append /32)
CLUSTER_AUTHORIZED_NETWORKS=
# Empty = <gateway-ip>.sslip.io (no DNS needed). Set it if you own a domain.
APP_HOSTNAME=
# Needed when APP_HOSTNAME is set: up.sh creates its DNS record and down.sh deletes it, so the
# name never points at a released IP. Token scope: Zone > DNS > Edit, on this zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---------- Kubernetes layer (scripts/gke/apply-k8s.sh) ----------
# OAuth client for Identity-Aware Proxy, created once in the console (see platform/k8s/README.md).
IAP_OAUTH_CLIENT_ID=
IAP_OAUTH_CLIENT_SECRET=

# ---------- Local k3d ----------
K3D_CLUSTER_NAME=agents-local
K3D_REGISTRY_NAME=gke-registry.localhost
K3D_REGISTRY_PORT=5000
K8S_NAMESPACE=agents
# Models behind the LiteLLM aliases on k3d (scripts/local/apply-k8s.sh; GKE always uses full):
#   flash-lite  fast and smart both call Gemini Flash-Lite (cheapest real model; default)
#   full        same as GKE: fast = Flash-Lite, smart = Flash
#   mock        no model calls: canned answers that match each request's schema, $0
LOCAL_MODELS=flash-lite
# mock only: delay per call (time to kill the worker mid-call) and share of calls that fail (retries).
MOCK_LATENCY_SECONDS=2
MOCK_FAILURE_RATE=0

# ---------- App secrets (loaded into k3d as a K8s Secret by scripts/local/load-secrets.sh) ----------
# Prefix with SECRET_ to have the loader pick it up; the prefix is stripped.
# SECRET_LLM_API_KEY=replace-me
