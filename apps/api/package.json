  },
  "dependencies": {
    "@agents/invoice-exception-resolver": "workspace:*",
    "@fastify/static": "10.1.10",
    "@temporalio/client": "1.25.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  }
}
