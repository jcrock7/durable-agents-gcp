# Example only. scripts/gke/up.sh sets these from .env as TF_VAR_* variables.

project_id   = "your-project-id"
region       = "us-central1"
state_bucket = "your-project-id-tfstate"
cluster_name = "agents-demo"

# Who may reach the Kubernetes API: your own IP (curl -s ifconfig.me) as a /32. Required.
authorized_networks = [{ cidr = "203.0.113.10/32", name = "me" }]

# Leave empty to use <gateway-ip>.sslip.io
app_hostname = ""
