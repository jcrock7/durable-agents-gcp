# Shape of local.env, written by scripts/local/apply-k8s.sh (gitignored).
# Merged into the litellm-env ConfigMap.
VERTEX_PROJECT=your-project-id
# From LOCAL_MODELS in .env (flash-lite by default; mock answers without calling a model).
LITELLM_FAST_MODEL=vertex_ai/gemini-3.5-flash-lite
LITELLM_SMART_MODEL=vertex_ai/gemini-3.5-flash-lite
MOCK_LATENCY_SECONDS=2
MOCK_FAILURE_RATE=0
