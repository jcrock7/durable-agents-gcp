# Pinned tool versions for scripts/dev-env/setup-wsl.sh and setup-windows.ps1.
# One KEY=VALUE per line, no quotes, no trailing comments (read by bash and PowerShell).
#
# To update:  scripts/dev-env/setup-wsl.sh --check          (shows installed / pinned / latest)
#             scripts/dev-env/setup-wsl.sh --bump [tool...] (writes the latest into this file, then installs)
# Then commit this file so every machine gets the same versions.

# Prompt
OMP_VERSION=33.0.0

# Node.js (fnm manages Node; pnpm is a global npm package on both Windows and WSL)
FNM_VERSION=1.39.0
NODE_VERSION=26.13.1
PNPM_VERSION=12.21.0

# Kubernetes
KUBECTL_VERSION=1.36.1
K9S_VERSION=0.51.0
K3D_VERSION=5.9.0
# Helm 4 is out; the project still uses Helm 3, so bump this one deliberately.
HELM_VERSION=3.16.3

# Infrastructure as code
TERRAFORM_VERSION=1.17.2

# Secret scanning and Python tooling (pre-commit is installed with uv)
GITLEAKS_VERSION=8.30.1
UV_VERSION=0.13.9
PRE_COMMIT_VERSION=4.7.0
